# Nova Browser API Configuration
# Optional: Set your preferred AI API key for LLM-driven planning & reasoning.
# If left blank, Nova uses its intelligent built-in dynamic task planner.

# Google Gemini API Key (Recommended)
GEMINI_API_KEY=

# OpenAI API Key (Alternative)
OPENAI_API_KEY=

# AI Model Selection (e.g. gemini-2.0-flash, gemini-1.5-pro, gpt-4o, gpt-4o-mini)
AI_MODEL=gemini-2.0-flash
